# Copy to .env and fill in. Expo exposes only EXPO_PUBLIC_* to the client.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Auth
# Primary beta sign-in is email + password. Magic-link sign-in and password recovery both
# return through the existing voxa://auth/callback deep link.
# Optional native override (default is already voxa://auth/callback):
# EXPO_PUBLIC_AUTH_REDIRECT_NATIVE=voxa://auth/callback
# Optional web callback origin/path override:
# EXPO_PUBLIC_AUTH_WEB_REDIRECT_URL=https://your-site.example/auth/callback

# PostHog (client)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# RevenueCat foundation (client)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# Practice mode: `text` (Groq/Gemini via Edge Function) or `voice` (OpenAI Realtime)
EXPO_PUBLIC_AI_MODE=text

# Edge Function URLs normally derive automatically from EXPO_PUBLIC_SUPABASE_URL.
# Only set these if you deliberately need a different endpoint/project.
# EXPO_PUBLIC_REALTIME_SESSION_URL=https://<PROJECT_REF>.supabase.co/functions/v1/realtime-session
# EXPO_PUBLIC_AI_CHAT_COACH_URL=https://<PROJECT_REF>.supabase.co/functions/v1/ai-chat-coach
# EXPO_PUBLIC_ELEVENLABS_TTS_URL=https://<PROJECT_REF>.supabase.co/functions/v1/elevenlabs-tts

# Set to 1 for App Store / Product Hunt screenshot builds (optional marketing banner on Practice tab).
EXPO_PUBLIC_SCREENSHOT_MODE=

# ─── Security ─────────────────────────────────────────────────────────────────
# Local .env must contain ONLY EXPO_PUBLIC_* values (see docs/SECURITY.md).
# Never put Groq, Gemini, ElevenLabs, OpenAI, service role, or DATABASE_URL here.
#
# Private AI keys → Supabase Edge Function secrets only:
#   supabase secrets set GROQ_API_KEY="..."
#   supabase secrets set GEMINI_API_KEY="..."
#   supabase secrets set ELEVENLABS_API_KEY="..."
#   supabase secrets set OPENAI_API_KEY="..."
#
# Postgres / service role (migrations, scripts, CI only — NOT in Expo .env):
#   Use `supabase link` + CLI, or a separate gitignored file outside the app tree.
